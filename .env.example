# ── Variables de entorno ──
# LOCAL: copia como .env
# RAILWAY/RENDER: configura en el panel Variables del servicio

# Entorno
ENVIRONMENT=production

# Base de datos
# SQLite (local/demo): sqlite:///./evidentra_mvp.db
# PostgreSQL (Railway lo pone automático): postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./evidentra_mvp.db

# CORS — "*" para HTML estático, dominios específicos para producción real
CORS_ORIGINS_STR=*
